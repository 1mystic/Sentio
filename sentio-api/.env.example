# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model for AI Guide chat. Haiku = fast/cheap, Sonnet = higher quality.
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_MODEL=claude-sonnet-4-6

# Cohere (for RAG reranking)
COHERE_API_KEY=...

# HuggingFace (optional — not actively used)
HF_API_TOKEN=hf_...

# App
FRONTEND_URL=https://your-vercel-app.vercel.app
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# Admin Dashboard credentials (gitignored — never commit actual values)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-password

# Email delivery via Resend (free tier: 3,000/month, 100/day)
# Sign up at https://resend.com — no credit card required
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App public URL (used in email links)
APP_URL=https://your-vercel-app.vercel.app
