# Sentio Backend Environment Variables
# Copy this to .env and fill in your actual values

# -- Database ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# -- LLM Provider (choose one or both for fallback) -------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Optional model overrides
CLAUDE_MODEL=claude-haiku-4-5-20251001
FALLBACK_MODEL=google/gemini-flash-1.5-exp

# -- Reranker (optional, RAG degrades gracefully without it) ---------------
COHERE_API_KEY=your-cohere-api-key

# -- Email delivery (optional, stubs if absent) ------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@sentio.app

# -- External NLP (optional, local VADER fallback if absent) ----------------
JOURNAL_NLP_URL=https://your-hf-space.hf.space/analyze

# -- App URL (optional, for email links) -------------------------------------
APP_URL=https://sentio.app
